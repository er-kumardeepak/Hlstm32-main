# Database: SQLite fallback for local dev; set to PostgreSQL in production.
# SQLite:   sqlite:///./energy_monitor.db
# Postgres: postgresql://postgres:password@localhost:5432/energy_monitor
DATABASE_URL=sqlite:///./energy_monitor.db

# Comma-separated origins allowed to call the API (frontend dev server).
ALLOWED_ORIGINS=http://localhost:5173

# Optional ingestion security. Leave empty to disable the key check.
DEVICE_API_KEY=

# Alert thresholds
LOW_VOLTAGE_THRESHOLD=200
HIGH_VOLTAGE_THRESHOLD=250

EM2M_MAX_CURRENT=10
EM2M_MAX_POWER=2200

EM4M_MAX_CURRENT=20
EM4M_MAX_POWER=5000

DEVICE_OFFLINE_SECONDS=30
ALERT_COOLDOWN_SECONDS=300

# Future ML module switch (not implemented yet)
ML_ENABLED=false
